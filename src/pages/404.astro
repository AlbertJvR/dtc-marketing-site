---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout path="/404" title="Page not found" noindex>
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:px-8">
    <p class="eyebrow"><span class="eyebrow-mark"></span>404</p>
    <h1 class="mt-4 max-w-xl text-title-md font-bold tracking-tight text-gray-900 sm:text-title-lg">
      That page isn’t here.
    </h1>
    <p class="mt-4 max-w-md text-base leading-7 text-gray-600">
      It may have moved, or the link was wrong. The pages below are a good place to start.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary btn-lg w-full sm:w-auto">Back to home</a>
      <a href="/contact" class="btn btn-outline btn-lg w-full sm:w-auto">Contact us</a>
    </div>
  </section>
</BaseLayout>
