---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { CONTACT_EMAIL, FOUNDER, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from '@config/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the current page for the canonical URL, e.g. "/contact". */
  path?: string;
  /** Keep the page out of search results (404). Also drops the canonical/og:url tags. */
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, path = '/', noindex = false } = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const siteUrl = Astro.site ?? new URL('http://localhost:4321');
// Cloudflare Pages serves each page at its trailing-slash URL (/services/) and the sitemap
// lists that form, so the canonical must match it rather than point at a redirect.
const canonical = new URL(path.endsWith('/') ? path : `${path}/`, siteUrl).href;
const ogImage = new URL('/images/og-image.png', siteUrl).href;
const ogImageAlt = `${SITE_NAME} — ${SITE_TAGLINE}`;

// Structured data (JSON-LD) on the home page only: who the studio is and what it offers.
const homeUrl = new URL('/', siteUrl).href;
const structuredData =
  path === '/'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': ['Organization', 'ProfessionalService'],
            '@id': `${homeUrl}#organization`,
            name: SITE_NAME,
            url: homeUrl,
            logo: new URL('/apple-touch-icon.png', siteUrl).href,
            image: ogImage,
            description,
            email: CONTACT_EMAIL,
            founder: { '@type': 'Person', name: FOUNDER.name },
            address: { '@type': 'PostalAddress', addressCountry: 'NZ' },
            areaServed: 'NZ',
            knowsAbout: ['Web development', 'Web applications', 'Custom software', 'Software hosting and support'],
          },
          {
            '@type': 'WebSite',
            '@id': `${homeUrl}#website`,
            name: SITE_NAME,
            url: homeUrl,
            publisher: { '@id': `${homeUrl}#organization` },
          },
        ],
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1b1916" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-gray-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
