---
/**
 * One service tier on the home page: numbered, ruled at the top, with a link to the
 * matching section on /services. Deliberately not a boxed "feature card" — the rule
 * and the number do the work.
 */
interface Props {
  index: number;
  title: string;
  summary: string;
  href: string;
}
const { index, title, summary, href } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<a href={href} class="group flex flex-col border-t border-gray-300 pt-6 transition hover:border-gray-900">
  <span class="text-theme-sm font-semibold tabular-nums text-brand-600">{number}</span>
  <h3 class="mt-3 text-theme-xl font-bold tracking-tight text-gray-900">{title}</h3>
  <p class="mt-2 flex-1 text-base leading-7 text-gray-600">{summary}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-theme-sm font-semibold text-gray-900">
    Learn more
    <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12m0 0l-4-4m4 4l-4 4" />
    </svg>
    <span class="sr-only">about {title}</span>
  </span>
</a>
