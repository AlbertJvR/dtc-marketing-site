---
/**
 * Deploy the Camel lockup (line-art camel + wordmark), served from public/logo.png
 * (859×426, transparent). Size it with a height utility via `class`; width follows.
 * The favicon set and the social image are generated from public/logo-mark.png and
 * this file (see README → "Logo and icons").
 */
interface Props {
  /** Sizing classes, e.g. "h-12". Height controls the lockup size. */
  class?: string;
}
const { class: className } = Astro.props;
---

<img
  src="/logo.png"
  alt="Deploy the Camel"
  width="859"
  height="426"
  decoding="async"
  class:list={['block h-12 w-auto', className]}
/>
